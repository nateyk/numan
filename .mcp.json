{
    "mcpServers": {
        "laravel-boost": {
            "command": "ddev",
            "args": [
                "exec",
                "php",
                "artisan",
                "boost:mcp"
            ]
        },
        "shadcn": {
            "command": "npx",
            "args": [
                "-y",
                "shadcn@latest",
                "mcp"
            ]
        }
    }
}
