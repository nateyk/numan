{
    "$schema": "https://www.schemastore.org/package.json",
    "name": "laravel-saas-starter",
    "description": "A production-ready Laravel SaaS starter kit with authentication, billing, teams, and everything you need to launch faster. Built by XCO Agency.",
    "private": true,
    "packageManager": "pnpm@10.33.0",
    "type": "module",
    "author": "XCO Agency <support@xco.agency>",
    "repository": {
        "type": "git",
        "url": "https://github.com/xco-agency/laravel-saas-starter.git"
    },
    "scripts": {
        "build": "vite build",
        "build:ssr": "vite build && vite build --ssr",
        "dev": "vite",
        "format": "prettier --write resources/",
        "format:check": "prettier --check resources/ || (prettier --write resources/js/components/freight/freight-details-card.tsx resources/js/pages/connections/show.tsx resources/js/pages/discover/index.tsx resources/js/pages/freight/index.tsx resources/js/pages/freight/schedule.tsx resources/js/pages/freight/show.tsx; git diff --no-ext-diff --unified=0 -- resources/js; exit 1)",
        "lint": "eslint . --fix",
        "types": "tsc --noEmit",
        "fix": "npm run format && npm run lint && npm run types",
        "wayfinder": "php artisan wayfinder:generate --with-form && sed -i 's/    2faRequired: Object.assign/    \"2faRequired\": Object.assign/' resources/js/routes/admin/index.ts resources/js/routes/workspace/index.ts",
        "wayfinder:check": "npm run types"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@laravel/echo-react": "^2.6.3",
        "@laravel/vite-plugin-wayfinder": "^0.1.11",
        "@types/leaflet": "^1.9.22",
        "@types/node": "^26.6.6",
        "babel-plugin-react-compiler": "^1.0.0",
        "baseline-browser-mapping": "^2.11.37",
        "eslint": "^9.39.5",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "laravel-echo": "^2.6.3",
        "leaflet": "^1.9.4",
        "prettier": "^3.10.1",
        "prettier-plugin-organize-imports": "^4.3.0",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "pusher-js": "^8.6.0",
        "typescript-eslint": "^8.72.2"
    },
    "dependencies": {
        "@headlessui/react": "^2.2.10",
        "@inertiajs/react": "^3.11.0",
        "@radix-ui/react-avatar": "^1.3.1",
        "@radix-ui/react-checkbox": "^1.4.1",
        "@radix-ui/react-collapsible": "^1.2.1",
        "@radix-ui/react-dialog": "^1.3.1",
        "@radix-ui/react-dropdown-menu": "^2.2.1",
        "@radix-ui/react-label": "^2.1.17",
        "@radix-ui/react-navigation-menu": "^1.4.1",
        "@radix-ui/react-popover": "^1.3.1",
        "@radix-ui/react-select": "^2.4.1",
        "@radix-ui/react-separator": "^1.2.0",
        "@radix-ui/react-slot": "^1.5.0",
        "@radix-ui/react-toggle": "^1.2.1",
        "@radix-ui/react-toggle-group": "^1.2.1",
        "@radix-ui/react-tooltip": "^1.4.1",
        "@sentry/browser": "^10.78.0",
        "@sentry/react": "^10.78.0",
        "@sentry/vite-plugin": "^5.4.1",
        "@tailwindcss/vite": "^4.3.5",
        "@tanstack/react-table": "^9.3.1",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.3.0",
        "axios": "^1.21.1",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "cmdk": "^1.1.1",
        "concurrently": "^10.0.7",
        "date-fns": "^4.4.0",
        "globals": "^17.14.0",
        "i18next": "^26.7.2",
        "i18next-browser-languagedetector": "^8.3.0",
        "input-otp": "^1.5.0",
        "laravel-vite-plugin": "^3.2.1",
        "lucide-react": "^1.73.0",
        "motion": "^12.43.0",
        "radix-ui": "^1.8.1",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-i18next": "^17.1.13",
        "react-image-crop": "^11.1.2",
        "react-leaflet": "^5.0.0",
        "recharts": "^3.10.1",
        "sonner": "^2.0.8",
        "tailwind-merge": "^3.7.0",
        "tailwindcss": "^4.3.5",
        "tw-animate-css": "^1.4.0",
        "typescript": "^6.0.3",
        "vite": "^8.3.8"
    },
    "pnpm": {
        "overrides": {
            "socket.io-parser": ">=4.2.6",
            "flatted": ">=3.4.2",
            "picomatch": ">=4.0.4",
            "brace-expansion": ">=1.1.13",
            "glob@>=9.0.0 <=14.0.1": ">=14.0.2",
            "minimatch@>=7.0.0 <11.0.1": ">=11.0.1"
        }
    },
    "optionalDependencies": {
        "@rollup/rollup-linux-x64-gnu": "4.63.3",
        "@rollup/rollup-win32-x64-msvc": "4.63.3",
        "@tailwindcss/oxide-linux-x64-gnu": "^4.3.5",
        "@tailwindcss/oxide-win32-x64-msvc": "^4.3.5",
        "lightningcss-linux-x64-gnu": "^1.33.0",
        "lightningcss-win32-x64-msvc": "^1.33.0"
    }
}
